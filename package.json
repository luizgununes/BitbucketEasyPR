{
  "name": "bitbucketeasypr",
  "displayName": "Bitbucket EasyPR",
  "description": "Opens a Pull Request on Bitbucket from VSCode",
  "version": "2.0.0",
  "publisher": "luizgununes",
  "icon": "assets/bitbucket.jpg",
  "license": "See LICENSE.md",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/luizgununes/BitbucketEasyPR.git"
  },
  "main": "./out/extension",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Bitbucket EasyPR Settings",
      "properties": {
        "easyPR.openBrowser": {
          "type": "boolean",
          "description": "Open Bitbucket on Browser after creating PR?",
          "default": false,
          "scope": "resource"
        }
      }
    },
    "commands": [
      {
        "command": "extension.createPullRequest",
        "title": "Create Pull Request",
        "category": "Bitbucket EasyPR"
      },
      {
        "command": "extension.clearCredentials",
        "title": "Clear Stored Credentials",
        "category": "Bitbucket EasyPR"
      },
      {
        "command": "extension.reconfigureCredentials",
        "title": "Reconfigure Credentials",
        "category": "Bitbucket EasyPR"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile",
    "package": "node_modules/.bin/vsce package",
    "publish": "node_modules/.bin/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vsce": "^1.66.0"
  },
  "dependencies": {
    "@types/vscode": "^1.86.0",
    "node-fetch": "^3.3.2"
  }
}
