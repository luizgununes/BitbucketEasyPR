{
  "name": "bitbucketeasypr",
  "displayName": "Bitbucket EasyPR",
  "description": "Opens a Pull Request on Bitbucket from VSCode",
  "version": "2.0.1",
  "publisher": "luizgununes",
  "author": {
    "name": "Luiz Gustavo Nunes",
    "email": "lgnunes.profissional@gmail.com",
    "url": "https://lgnunes.dev"
  },
  "icon": "assets/bitbucket.jpg",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "bitbucket",
    "bitbucket cloud",
    "atlassian",
    "pull request",
    "pull requests",
    "pr",
    "git",
    "scm",
    "source control",
    "code review",
    "repository",
    "workflow",
    "api token",
    "vscode extension",
    "developer tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/luizgununes/BitbucketEasyPR.git"
  },
  "homepage": "https://github.com/luizgununes/BitbucketEasyPR#readme",
  "bugs": {
    "url": "https://github.com/luizgununes/BitbucketEasyPR/issues"
  },
  "main": "./out/extension",
  "activationEvents": [
    "onCommand:extension.createPullRequest",
    "onCommand:extension.clearCredentials",
    "onCommand:extension.reconfigureCredentials"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Bitbucket EasyPR Settings",
      "properties": {
        "easyPR.openBrowser": {
          "type": "boolean",
          "description": "Open Bitbucket on Browser after creating PR?",
          "default": false,
          "scope": "resource"
        }
      }
    },
    "commands": [
      {
        "command": "extension.createPullRequest",
        "title": "Create Pull Request",
        "category": "Bitbucket EasyPR"
      },
      {
        "command": "extension.clearCredentials",
        "title": "Clear Stored Credentials",
        "category": "Bitbucket EasyPR"
      },
      {
        "command": "extension.reconfigureCredentials",
        "title": "Reconfigure Credentials",
        "category": "Bitbucket EasyPR"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile",
    "package": "node_modules/.bin/vsce package",
    "publish": "node_modules/.bin/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  }
}
